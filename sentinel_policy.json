{
  "_doc": "Sentinel v2 policy (P0, 2026-11-12). tier: read = no side effect; act = changes local state on a device; control = taps/typing on a screen; send/post/pay/account = outgoing or irreversible. Gated tiers (control/send/post/pay/account) ALWAYS need an Approve card and are audited. 'act' needs a card when the task has read untrusted data (web/screen/SMS/MCP). 'blocked' tools never run. Max act+gated calls per task = max_actions_per_task.",
  "version": 2,
  "max_actions_per_task": 25,
  "gated_tiers": ["control", "send", "post", "pay", "account"],
  "tools": {
    "web_search": "read", "browse": "read", "list_devices": "read", "screenshot": "read",
    "ui_dump": "read", "screen_read": "read", "sms_list": "read", "call_log": "read",
    "contacts": "read", "notifications": "read", "battery": "read", "location": "read",
    "sensor": "read", "app_list": "read", "camera_photo": "read", "mic_record": "read",
    "clipboard": "act", "app_launch": "act", "open_url": "act", "am_start": "act", "shell": "act",
    "mcp_call": "act", "call_control": "act",
    "click": "control", "tap": "control", "type_text": "control", "type": "control",
    "swipe": "control", "keyevent": "control",
    "sms_send": "send", "sms_fill": "send", "call_make": "send",
    "settings_ctl": "account", "app_stop": "account"
  },
  "untrusted_sources": ["web_search", "browse", "mcp_call", "screen_read", "ui_dump", "sms_list",
                        "notifications", "clipboard", "contacts", "call_log"],
  "sensitive_sources": ["sms_list", "screen_read", "ui_dump", "contacts", "call_log", "notifications",
                        "clipboard", "location", "sensor", "camera_photo", "mic_record", "sms_fill", "sms_send"],
  "blocked": []
}

# Bangla Bhai config - copy to .env and fill in. NEVER commit .env
# Owner login
BB_USER=royal
BB_PASSWORD=change-me
# Random long string (install.ps1 generates one)
BB_SESSION_SECRET=
# 1 = show login OTP in otp_dev_last.json instead of emailing (testing only)
BB_OTP_DEV=0

# Free AI keys
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional voice
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Login-code email (choose one)
# Resend: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=Bangla Bhai <onboarding@resend.dev>
# Or Gmail SMTP with an App Password
EMAIL=
PASSWORD=

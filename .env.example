# Bangla Bhai config. Copy to .env and fill in. NEVER commit .env
# On Windows, windows\run.py copies these into %USERPROFILE%\.secrets\ (where the app reads them) on every start.

# --- Owner login ---
BB_USER=
BB_PASSWORD=
# Owner email: logging in with an email code to this address gives owner access
BB_OWNER_EMAIL=
# Long random string (install.ps1 generates one)
BB_SESSION_SECRET=
# 1 = keep login codes local instead of emailing (testing only). Keep 0.
BB_OTP_DEV=
# 1 = allow login cookies over plain http (local testing only). Keep empty in production.
BB_INSECURE_COOKIE=
# Only when running behind the Cloudflare Worker: shared secret the Worker sends. Leave empty for a direct cloudflared tunnel.
BB_EDGE_SECRET=

# --- Free AI keys ---
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cloudflare Workers AI token (optional fallback model and free images)
BBAI_TOKEN=

# --- Voice (optional) ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=

# --- Login-code email (choose one) ---
# Resend: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=
# Or Gmail SMTP with an App Password (AGENT_GMAIL/AGENT_GMAIL_PASSWORD also accepted)
EMAIL=
PASSWORD=

# --- Telegram bot (optional, from @BotFather) ---
BB_TELEGRAM_TOKEN=

# --- Web push (VAPID_PUBLIC + private key file are generated automatically by windows\run.py) ---
VAPID_PUBLIC=
VAPID_SUB=

# --- Studio daily free limits per user ---
BB_FREE_IMG_DAY=
BB_FREE_VID_DAY=
